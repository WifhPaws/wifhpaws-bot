# ==============================================================================
# WifhPaws Telegram Bot Environment Configuration
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Telegram Bot API Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Supabase Project URL & Anon Key (from Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Comma-separated list of Telegram User IDs authorized for admin commands
ADMIN_USER_IDS=123456789

# 32-byte secret key used to encrypt/decrypt custodial private keys (AES-256-GCM)
WALLET_ENCRYPTION_KEY=generate_random_32_byte_hex_key_here

# (Optional) Contract address for the WIFH ERC-20 token
WIFH_CONTRACT_ADDRESS=

# (Optional) RPC URL for the Robinhood Chain (defaults to https://rpc.mainnet.chain.robinhood.com)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
