# ==============================================================================
# WifhPaws Telegram Bot Environment Configuration
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Telegram Bot API Token (obtained from @BotFather on Telegram)
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=your_telegram_bot_token_here

# Supabase Project URL (found in Project Settings > API)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous or Service Role API Key (found in Project Settings > API)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Comma-separated list of Telegram User IDs authorized for admin commands (e.g. /airdrop)
# Tip: Send /start to @userinfobot to find your Telegram numeric ID
# Example: 123456789,987654321
ADMIN_USER_IDS=123456789
